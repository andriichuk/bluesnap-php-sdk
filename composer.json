{
    "name": "andriichuk/bluesnap-php-sdk",
    "description": "A framework-agnostic PHP SDK for the BlueSnap Payment API.",
    "keywords": [
        "bluesnap",
        "payments",
        "subscriptions",
        "sdk"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Serhii Andriichuk",
            "email": "andriichuk29@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Andriichuk\\BlueSnap\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Andriichuk\\BlueSnap\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "pint",
        "format:test": "pint --test",
        "test": "phpunit",
        "analyse": "phpstan analyse --debug --no-progress --memory-limit=1G",
        "check": [
            "@format:test",
            "@test",
            "@analyse"
        ]
    },
    "config": {
        "allow-plugins": false,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
